#!/usr/bin/env bash
# Pinned tool versions for the quality gate image.
#
# Single source of truth: sourced by the Containerfile at build time; the
# shim (verify.sh) derives the image tag from this file's content hash, so
# any pin change forces an image rebuild. Tools land here together with the
# step that needs them — nothing speculative.
#
# Base image: official node slim, digest-pinned (multi-arch manifest list)
# so rebuilds are reproducible and arm64 hosts work unmodified.

NODE_IMAGE_TAG="26.7.0-slim"
NODE_IMAGE_DIGEST="sha256:5758d367d7b4f48b73a9bb3530e687e47efb289f3b43f9c0450a25225ae0db5d"

# Global typescript inside the image: used to typecheck the gate's own code
# (`tsc --noEmit`). The gate still *runs* on node strip-types with no build.
TYPESCRIPT_VERSION="7.0.2"
