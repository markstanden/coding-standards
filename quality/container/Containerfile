# Quality gate runtime image.
#
# Official node slim base, digest-pinned via tool-versions.env (multi-arch
# manifest list, so arm64 works unmodified). The gate's TypeScript code is
# NOT baked in — verify.sh bind-mounts quality/ read-only at /opt/quality so
# local edits run without a rebuild. Only tool pins change this image; the
# shim tags it from tool-versions.env's content hash.
# Base image pins arrive as build args from verify.sh (which sources
# tool-versions.env) so that file remains the single source of truth.
ARG NODE_IMAGE_TAG
ARG NODE_IMAGE_DIGEST

FROM docker.io/library/node:${NODE_IMAGE_TAG}@${NODE_IMAGE_DIGEST}

ENV DEBIAN_FRONTEND=noninteractive

COPY tool-versions.env /usr/local/share/quality/tool-versions.env

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        git \
        shellcheck \
        shfmt \
        yamllint \
        curl \
        ca-certificates \
    ; \
    rm -rf /var/lib/apt/lists/*; \
    . /usr/local/share/quality/tool-versions.env; \
    test "$(shellcheck --version | sed -n 's/^version: //p')" = "${SHELLCHECK_VERSION}"; \
    test "$(shfmt --version)" = "${SHFMT_VERSION}"; \
    test "$(yamllint --version | cut -d' ' -f2)" = "${YAMLLINT_VERSION}"; \
    npm install --global "typescript@${TYPESCRIPT_VERSION}"; \
    npm install --global "prettier@${PRETTIER_VERSION}"; \
    tsc --version; \
    test "$(prettier --version)" = "${PRETTIER_VERSION}"; \
    arch="$(uname -m)"; \
    case "${arch}" in \
        x86_64) ARCH="amd64"; ZIZMOR_ARCH="x86_64"; GITLEAKS_ARCH="x64" ;; \
        aarch64) ARCH="arm64"; ZIZMOR_ARCH="aarch64"; GITLEAKS_ARCH="arm64" ;; \
        *) echo "Unsupported arch: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_${ARCH}.tar.gz" | tar -xz -C /usr/local/bin actionlint; \
    actionlint --version >/dev/null; \
    curl -fsSL "https://github.com/zizmorcore/zizmor/releases/download/v${ZIZMOR_VERSION}/zizmor-${ZIZMOR_ARCH}-unknown-linux-gnu.tar.gz" | tar -xz -C /usr/local/bin zizmor; \
    zizmor --version >/dev/null; \
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz" | tar -xz -C /usr/local/bin gitleaks; \
    gitleaks --version >/dev/null; \
    node --version

WORKDIR /repo
ENTRYPOINT ["node", "/opt/quality/verify.mts"]
