#!/usr/bin/env bash
# cli/defined — installed host launcher for the defined gate (decision #25).
#
# The only public surface: `defined comply` and `defined verify`. Reads the
# consumer's committed .defined-version pin, picks a container engine (podman
# preferred), ensures the exact image is present, then runs it — mounting the
# repo read-write for comply, read-only for verify. No gate behaviour lives
# here; everything else is in the image.
#
# Needs only git + podman/docker on the host. Install: put this file on PATH
# (normally ~/.local/bin/defined). Source development uses runtime/verify.sh.
# The runtime's .defined-version parser is exercised here end-to-end; the
# producer repo does not commit its own pin (a file containing its own SHA is
# impossible by construction).

set -euo pipefail

VERSION_FILE=".defined-version"
IMAGE_REPO="ghcr.io/markstanden/defined"
PROGRAM="$(basename "${BASH_SOURCE[0]}")"

usage() {
    echo "usage: ${PROGRAM} comply | ${PROGRAM} verify" >&2
    return 0
}

die() {
    echo "${PROGRAM}: $*" >&2
    exit 1
}

# Resolve the enclosing git root from the invocation CWD.
repo_root() {
    git -C "${PWD}" rev-parse --show-toplevel 2>/dev/null ||
        die "not inside a git repository"
}

# Read and validate the immutable image pin from .defined-version.
# Prints the validated pin on success; errors name the path. Mutable aliases
# (empty, latest, non-SHA tokens) are rejected so local and CI always run the
# exact same image (release identity, PLAN.md).
read_pin() {
    local root="$1"
    local file="${root}/${VERSION_FILE}"
    if [[ ! -f "${file}" ]]; then
        die "no ${VERSION_FILE} in ${root} — commit a pin first"
    fi
    local pin
    pin="$(tr -d '[:space:]' <"${file}")"
    if [[ -z "${pin}" ]]; then
        die "${file} is empty — it must hold an immutable image tag"
    fi
    if [[ "${pin}" == "latest" ]]; then
        die "${file} must pin an immutable tag, not 'latest'"
    fi
    if [[ ! "${pin}" =~ ^[0-9a-f]{7,40}$ ]]; then
        die "${file} has an invalid pin '${pin}' — expected a git SHA"
    fi
    echo "${pin}"
}

# Choose the engine: podman preferred over docker; absent engine fails loudly.
pick_engine() {
    local engine="${DEFINED_ENGINE:-}"
    if [[ -n "${engine}" ]]; then
        command -v "${engine}" >/dev/null 2>&1 ||
            die "engine '${engine}' not found"
        echo "${engine}"
        return 0
    fi
    if command -v podman >/dev/null 2>&1; then
        echo "podman"
    elif command -v docker >/dev/null 2>&1; then
        echo "docker"
    else
        die "no container engine found — install podman or docker"
    fi
}

# Ensure the exact image is present; pull on first use, fail offline.
ensure_image() {
    local engine="$1" image="$2"
    if "${engine}" image inspect "${image}" >/dev/null 2>&1; then
        return 0
    fi
    if ! "${engine}" pull "${image}" >/dev/null 2>&1; then
        die "image ${image} unavailable (offline, or pin not yet published?)"
    fi
    return 0
}

main() {
    local verb="${1:-}"
    if [[ "${verb}" == "-h" || "${verb}" == "--help" ]]; then
        usage
        return 0
    fi
    if [[ "${verb}" != "comply" && "${verb}" != "verify" ]]; then
        usage
        return 2
    fi

    local root engine pin image
    root="$(repo_root)" || return 1
    engine="$(pick_engine)" || return 1
    pin="$(read_pin "${root}")" || return 1
    image="${IMAGE_REPO}:${pin}"
    ensure_image "${engine}" "${image}" || return 1

    # Decision #3: project deps restore inside the container onto named
    # volumes keyed by pin + repo, so host↔image ABI mismatches never leak in
    # and a pin change gets a fresh dependency cache.
    local repo_hash mount_arg
    repo_hash="$(printf '%s' "${root}" | sha256sum | cut -c1-12)"
    mount_arg="-v ${root}:/repo"
    if [[ "${verb}" == "verify" ]]; then
        mount_arg="-v ${root}:/repo:ro"
    fi

    # shellcheck disable=SC2086 # mount_arg is two words by design
    "${engine}" run --rm \
        ${mount_arg} \
        -v "defined-node-${pin}-${repo_hash}:/repo/node_modules" \
        -v "defined-npm-${repo_hash}:/root/.npm" \
        -v "defined-nuget-${repo_hash}:/root/.nuget/packages" \
        -e "NUGET_PACKAGES=/root/.nuget/packages" \
        --workdir /repo \
        "${image}" "${verb}"
}

main "$@"
